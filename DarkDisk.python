import tkinter as tk
from tkinter import ttk, filedialog, messagebox, simpledialog
import os
import shutil
import sqlite3
import hashlib

# --- Константы ---
APP_NAME = "DarkDisk"
STORAGE_DIR = "DarkDisk_Storage"
DB_FILE = "darkdisk.db"

class DarkDiskApp:
    def __init__(self, root):
        self.root = root
        self.root.title(APP_NAME)
        self.root.geometry("800x600") # Большое окно

        # Создаем папку для хранения, если ее нет
        if not os.path.exists(STORAGE_DIR):
            os.makedirs(STORAGE_DIR)

        # Инициализация базы данных
        self.conn = sqlite3.connect(DB_FILE)
        self.cursor = self.conn.cursor()
        self._init_db()

        # Загрузка настроек
        self.current_theme = self._get_setting('theme', 'light')
        self.hashed_password = self._get_setting('password', None)

        # --- Создание интерфейса ---
        self.main_frame = tk.Frame(root)
        self.main_frame.pack(fill=tk.BOTH, expand=True)

        # Рамка для вкладок слева
        self.tabs_frame = tk.Frame(self.main_frame, width=200)
        self.tabs_frame.pack(side=tk.LEFT, fill=tk.Y, padx=5, pady=5)
        self.tabs_frame.pack_propagate(False) # Фиксируем ширину

        # Рамка для контента справа
        self.content_frame = tk.Frame(self.main_frame)
        self.content_frame.pack(side=tk.RIGHT, fill=tk.BOTH, expand=True, padx=5, pady=5)

        # Создаем вертикальные вкладки
        self._create_tabs()

        # Применяем тему
        self._apply_theme()

        # Показываем первую вкладку по умолчанию
        self.show_main_tab()

        # Обработка закрытия окна
        self.root.protocol("WM_DELETE_WINDOW", self._on_closing)

    def _init_db(self):
        """Создает таблицы в БД, если их нет."""
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS files (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                filename TEXT NOT NULL,
                stored_path TEXT NOT NULL,
                is_secret INTEGER DEFAULT 0
            )
        ''')
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        ''')
        self.conn.commit()

    def _get_setting(self, key, default=None):
        """Получает значение настройки из БД."""
        self.cursor.execute("SELECT value FROM settings WHERE key=?", (key,))
        result = self.cursor.fetchone()
        return result[0] if result else default

    def _set_setting(self, key, value):
        """Сохраняет значение настройки в БД."""
        self.cursor.execute("INSERT OR REPLACE INTO settings (key, value) VALUES (?, ?)", (key, value))
        self.conn.commit()

    def _create_tabs(self):
        """Создает кнопки-вкладки слева."""
        # Используем ttk.Button для более современного вида
        self.tab_buttons = {}
        tabs_info = [
            ("Основная", self.show_main_tab),
            ("Добавить File+", self.show_add_file_tab),
            ("Секретные файлы [<>]", self.show_secret_files_tab),
            ("[&<] Настроить код", self.show_settings_tab)
        ]
        for text, command in tabs_info:
            btn = ttk.Button(self.tabs_frame, text=text, command=command, width=18)
            btn.pack(pady=5, fill=tk.X)
            self.tab_buttons[text] = btn

    def _clear_content_frame(self):
        """Очищает фрейм с контентом."""
        for widget in self.content_frame.winfo_children():
            widget.destroy()

    def _apply_theme(self):
        """Применяет цветовую схему к главному окну."""
        colors = {
            'light': {'bg': '#f0f0f0', 'fg': 'black', 'button_bg': '#e0e0e0'},
            'dark': {'bg': '#2b2b2b', 'fg': 'white', 'button_bg': '#3c3c3c'}
        }
        theme = colors[self.current_theme]
        self.root.configure(bg=theme['bg'])
        self.main_frame.configure(bg=theme['bg'])
        self.tabs_frame.configure(bg=theme['bg'])
        self.content_frame.configure(bg=theme['bg'])
        # Стиль для кнопок ttk
        style = ttk.Style()
        style.theme_use('clam') # Используем тему, которую легко стилизовать
        style.configure('TButton', background=theme['button_bg'], foreground=theme['fg'])
        style.map('TButton', background=[('active', theme['fg'])], foreground=[('active', theme['bg'])])


    # --- Логика вкладок ---

    def show_main_tab(self):
        """Показывает вкладку 'Основная'."""
        self._clear_content_frame()
        tk.Label(self.content_frame, text="Основная", font=("Helvetica", 16, "bold"), bg=self.content_frame['bg']).pack(pady=10)

        # Список файлов
        list_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        list_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)

        scrollbar = tk.Scrollbar(list_frame)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)

        file_listbox = tk.Listbox(list_frame, yscrollcommand=scrollbar.set, font=("Helvetica", 10))
        file_listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.config(command=file_listbox.yview)

        self.cursor.execute("SELECT filename, is_secret FROM files ORDER BY is_secret, filename")
        for filename, is_secret in self.cursor.fetchall():
            prefix = "[СЕКРЕТ] " if is_secret else ""
            file_listbox.insert(tk.END, f"{prefix}{filename}")

        # Информация о месте
        try:
            total, used, free = shutil.disk_usage(STORAGE_DIR)
            free_gb = free / (1024**3)
            info_text = f"Свободно в хранилище: {free_gb:.2f} ГБ"
        except Exception as e:
            info_text = f"Не удалось получить информацию о диске: {e}"

        tk.Label(self.content_frame, text=info_text, font=("Helvetica", 12), bg=self.content_frame['bg']).pack(pady=10)

    def show_add_file_tab(self):
        """Показывает вкладку 'Добавить File+'."""
        self._clear_content_frame()
        tk.Label(self.content_frame, text="Добавить Файл", font=("Helvetica", 16, "bold"), bg=self.content_frame['bg']).pack(pady=10)

        self.selected_file_path = tk.StringVar()
        self.is_secret_var = tk.BooleanVar(value=False)

        # Выбор файла
        select_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        select_frame.pack(pady=10, fill=tk.X, padx=20)
        tk.Button(select_frame, text="Выбрать файл...", command=self._select_file).pack(side=tk.LEFT)
        tk.Label(select_frame, textvariable=self.selected_file_path, bg=self.content_frame['bg']).pack(side=tk.LEFT, padx=10)

        # Чекбокс для секретности
        tk.Checkbutton(self.content_frame, text="Сделать файл секретным", variable=self.is_secret_var, bg=self.content_frame['bg']).pack(pady=5)

        # Область для редактирования текста
        self.text_editor_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        self.text_editor = tk.Text(self.text_editor_frame, wrap=tk.WORD, height=15)
        self.text_editor.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)

        # Кнопка добавления
        tk.Button(self.content_frame, text="Добавить в хранилище", command=self._add_file_action, font=("Helvetica", 12)).pack(pady=10)
        
        self.text_editor_frame.pack_forget() # Изначально скрываем редактор

    def _select_file(self):
        """Открывает диалог выбора файла."""
        path = filedialog.askopenfilename()
        if path:
            self.selected_file_path.set(path)
            filename = os.path.basename(path)
            if filename.lower().endswith('.txt'):
                # Показываем редактор и загружаем в него текст
                self.text_editor_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=10)
                with open(path, 'r', encoding='utf-8') as f:
                    self.text_editor.delete(1.0, tk.END)
                    self.text_editor.insert(1.0, f.read())
            else:
                # Скрываем редактор для не-текстовых файлов
                self.text_editor_frame.pack_forget()


    def _add_file_action(self):
        """Добавляет выбранный файл в хранилище."""
        path = self.selected_file_path.get()
        if not path:
            messagebox.showwarning("Ошибка", "Файл не выбран!")
            return

        filename = os.path.basename(path)
        stored_path = os.path.join(STORAGE_DIR, filename)

        try:
            # Если это txt, сохраняем отредактированный текст
            if filename.lower().endswith('.txt'):
                with open(stored_path, 'w', encoding='utf-8') as f:
                    f.write(self.text_editor.get(1.0, tk.END))
            else:
                # Иначе просто копируем файл
                shutil.copy2(path, stored_path)

            # Записываем в БД
            is_secret = 1 if self.is_secret_var.get() else 0
            self.cursor.execute("INSERT INTO files (filename, stored_path, is_secret) VALUES (?, ?, ?)",
                                (filename, stored_path, is_secret))
            self.conn.commit()

            messagebox.showinfo("Успех", f"Файл '{filename}' добавлен!")
            self.selected_file_path.set("")
            self.text_editor.delete(1.0, tk.END)
            self.text_editor_frame.pack_forget()
            self.is_secret_var.set(False)
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось добавить файл: {e}")

    def show_secret_files_tab(self):
        """Показывает вкладку 'Секретные файлы'."""
        self._clear_content_frame()
        tk.Label(self.content_frame, text="Секретные файлы", font=("Helvetica", 16, "bold"), bg=self.content_frame['bg']).pack(pady=10)

        if not self.hashed_password:
            tk.Label(self.content_frame, text="Пароль не установлен. Задайте его в настройках.", bg=self.content_frame['bg']).pack(pady=20)
            return

        # Запрашиваем пароль
        password = simpledialog.askstring("Доступ запрещен", "Введите пароль:", show='*')
        if not password:
            self.show_main_tab() # Возвращаем на главную, если отмена
            return

        # Проверяем пароль
        if hashlib.sha256(password.encode()).hexdigest() != self.hashed_password:
            messagebox.showerror("Ошибка", "Неверный пароль!")
            self.show_main_tab() # Возвращаем на главную
            return

        # Показываем секретные файлы
        list_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        list_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)
        
        file_listbox = tk.Listbox(list_frame, font=("Helvetica", 10))
        file_listbox.pack(fill=tk.BOTH, expand=True)

        self.cursor.execute("SELECT filename FROM files WHERE is_secret=1")
        secret_files = self.cursor.fetchall()
        if not secret_files:
            file_listbox.insert(tk.END, "Секретных файлов нет.")
        else:
            for (filename,) in secret_files:
                file_listbox.insert(tk.END, filename)

    def show_settings_tab(self):
        """Показывает вкладку 'Настройки'."""
        self._clear_content_frame()
        tk.Label(self.content_frame, text="Настройки", font=("Helvetica", 16, "bold"), bg=self.content_frame['bg']).pack(pady=10)

        # Настройка пароля
        pass_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        pass_frame.pack(pady=10, fill=tk.X, padx=20)
        tk.Label(pass_frame, text="Новый пароль:", bg=self.content_frame['bg']).pack(side=tk.LEFT)
        self.new_pass_entry = tk.Entry(pass_frame, show="*", width=30)
        self.new_pass_entry.pack(side=tk.LEFT, padx=10)
        tk.Button(pass_frame, text="Установить", command=self._set_password_action).pack(side=tk.LEFT)

        # Настройка темы
        theme_frame = tk.Frame(self.content_frame, bg=self.content_frame['bg'])
        theme_frame.pack(pady=10, fill=tk.X, padx=20)
        tk.Label(theme_frame, text="Тема:", bg=self.content_frame['bg']).pack(side=tk.LEFT)
        self.theme_var = tk.StringVar(value=self.current_theme)
        ttk.Radiobutton(theme_frame, text="Светлая", variable=self.theme_var, value="light", command=self._set_theme_action).pack(side=tk.LEFT, padx=5)
        ttk.Radiobutton(theme_frame, text="Темная", variable=self.theme_var, value="dark", command=self._set_theme_action).pack(side=tk.LEFT, padx=5)

    def _set_password_action(self):
        """Устанавливает новый пароль."""
        password = self.new_pass_entry.get()
        if password:
            self.hashed_password = hashlib.sha256(password.encode()).hexdigest()
            self._set_setting('password', self.hashed_password)
            messagebox.showinfo("Успех", "Пароль успешно установлен!")
            self.new_pass_entry.delete(0, tk.END)
        else:
            messagebox.showwarning("Ошибка", "Пароль не может быть пустым.")

    def _set_theme_action(self):
        """Меняет тему и применяет ее."""
        self.current_theme = self.theme_var.get()
        self._set_setting('theme', self.current_theme)
        self._apply_theme()
        # Обновляем фон у всех дочерних виджетов в content_frame
        for widget in self.content_frame.winfo_children():
            try:
                widget.configure(bg=self.content_frame['bg'])
            except tk.TclError:
                pass # Некоторые виджеты (например, ttk) могут не поддерживать bg напрямую

    def _on_closing(self):
        """Закрывает соединение с БД при выходе."""
        if self.conn:
            self.conn.close()
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = DarkDiskApp(root)
    root.mainloop()
